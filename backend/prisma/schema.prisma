generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  username               String    @unique
  password               String
  role                   Role      @default(USER)
  passwordResetToken     String?   @unique
  passwordResetExpires   DateTime?
  courses                Course[]
  documents              Document[]
  tasks                  Task[]
  notifications          Notification[]
  courseSharesReceived   CourseShare[] @relation("SharedWith")
  courseSharesInitiated  CourseShare[] @relation("SharedBy")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model Course {
  id        String   @id @default(uuid())
  name      String
  color     String?
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  documents Document[]
  tasks     Task[]
  quizzes   Quiz[]
  courseShares CourseShare[]
  notifications Notification[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model Document {
  id        String   @id @default(uuid())
  filename  String
  bucket    String
  objectKey String
  fileSize  Int?
  fileType  String?
  courseId  String
  ownerId   String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([ownerId])
  @@index([bucket, objectKey])
}


model Task {
  id          String       @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(OPEN)
  position    Int          @default(0)
  completed   Boolean      @default(false)
  courseId    String
  userId      String
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([courseId])
  @@index([userId])
  @@index([courseId, userId])
  @@index([courseId, position])
}


model Quiz {
  id          String       @id @default(uuid())
  title       String
  description String?
  isOrderRandom Boolean    @default(false)
  questions   Question[]
  courseId    String
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  @@index([courseId])
}

enum QuestionType {
  MULTIPLE_CHOICE
  SINGLE_CHOICE
  CARD
}

model Question {
  id          String       @id @default(uuid())
  title       String
  description String?
  position    Int          @default(0)
  type        QuestionType @default(SINGLE_CHOICE)
  answers     Answer[]
  quizId      String
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  @@index([quizId])
  @@index([quizId, position])
}

model Answer {
  id          String       @id @default(uuid())
  isCorrect   Boolean      @default(true)
  content        String
  position    Int          @default(0)
  questionId  String
  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  @@index([questionId])
  @@index([questionId, position])
}

model CourseShare {
  id                String   @id @default(uuid())
  courseId          String
  sharedWithUserId  String
  sharedByUserId    String
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sharedWithUser    User     @relation("SharedWith", fields: [sharedWithUserId], references: [id], onDelete: Cascade)
  sharedByUser      User     @relation("SharedBy", fields: [sharedByUserId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@unique([courseId, sharedWithUserId])
  @@index([courseId])
  @@index([sharedWithUserId])
  @@index([sharedByUserId])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  data      Json?
  courseId  String?
  readAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([courseId])
  @@index([userId, readAt])
  @@index([createdAt])
}
